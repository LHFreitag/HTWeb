# Variáveis de ambiente — copie para chamados/.env.local e ajuste.
# .env.local é ignorado pelo git e não deve ser commitado.

# Ferramentas opcionais de medição. Só são carregadas depois que o visitante aceita
# no banner de cookies (LGPD). Deixe vazio para não usar.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Não existe mais VITE_ADMIN_TOKEN: o painel administrativo usa login do Firebase Auth.
# Veja FIRESTORE_RULES.md ("Como liberar um administrador").
